# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real ".env" file to GitHub.

# Rime TTS - get a key at https://app.rime.ai/tokens
RIME_API_KEY=

# LLM (Claude / Anthropic) - get a key at https://console.anthropic.com/settings/keys
LLM_API_KEY=

# Optional: only needed if you later swap browser STT for a server-side
# STT API in backend/stt.py. Not used by default.
STT_API_KEY=
